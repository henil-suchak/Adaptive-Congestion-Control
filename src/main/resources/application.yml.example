# ══════════════════════════════════════════════════════════
#  application.yml — EXAMPLE CONFIGURATION
#  Copy this file to application.yml and edit the values.
# ══════════════════════════════════════════════════════════

# ── Option A: H2 (embedded, zero setup — good for dev) ──
spring:
  datasource:
    url: jdbc:h2:file:./data/congestion-db
    driver-class-name: org.h2.Driver
    username: sa
    password:

  jpa:
    hibernate:
      ddl-auto: update
    show-sql: true
    properties:
      hibernate:
        format_sql: true

  h2:
    console:
      enabled: true
      path: /h2-console

server:
  port: 8080

